#!/bin/bash
# Use `USE_LEGACY_AWS_ENVIRONMENT=true aws-environment --init` to get your
# ~/.aws/config file set up first.

# Get all account IDs from AWS Organizations (using your main org account profile)
echo "Fetching accounts from AWS Organizations..."
accounts=$(aws organizations list-accounts \
    --query 'Accounts[?Status==`ACTIVE`].[Id,Name]' \
    --output text \
    )  # Replace with your org account profile

# Create output file with headers
output_file="canonical_ids_$(date +%Y%m%d_%H%M%S).csv"
echo "Account Name,Account ID,Canonical ID" > "$output_file"

# Process each account
while IFS=$'\t' read -r account_id account_name; do
    echo "Processing: $account_name ($account_id)"
    conventional_name=$(echo "${account_name}" | tr '[A-Z]' '[a-z]')

    # Generate the SSO profile name by IH conventions; not handling
    # multi-region now.
    profile_name="${conventional_name}-platform-us-east-1"

    # Try to get canonical ID using SSO profile
    canonical_id=$(aws s3api list-buckets \
        --query 'Owner.ID' \
        --output text \
        --profile "$profile_name" 2>/dev/null)

    if [ $? -eq 0 ] && [ -n "$canonical_id" ]; then
        echo "  ✓ Canonical ID: $canonical_id"
        echo "$account_name,$account_id,$canonical_id" >> "$output_file"
    else
        echo "  ✗ Failed to get canonical ID (check SSO profile: $profile_name)"
        echo "$account_name,$account_id,ERROR: Could not retrieve" >> "$output_file"
    fi

done <<< "$accounts"

echo ""
echo "Results saved to: $output_file"
echo ""
echo "Summary:"
cat "$output_file" | column -t -s ','
